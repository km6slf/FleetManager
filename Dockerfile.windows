# escape=`
# AREDN Fleet Manager, headless web UI, for Windows containers (Docker Desktop switched to
# "Windows containers", or Docker on Windows Server). Most Windows users want the Linux image
# instead (Docker Desktop's default). See README.md, "Docker".
ARG WINDOWS_VERSION=ltsc2022
FROM python:3.12-windowsservercore-${WINDOWS_VERSION}

LABEL org.opencontainers.image.title="AREDN Fleet Manager" `
      org.opencontainers.image.description="Safe, bulk management of AREDN mesh nodes (headless web UI)" `
      org.opencontainers.image.source="https://github.com/km6slf/FleetManager" `
      org.opencontainers.image.licenses="GPL-3.0"

ENV PYTHONDONTWRITEBYTECODE=1 `
    PYTHONUNBUFFERED=1 `
    PIP_NO_CACHE_DIR=1 `
    AREDN_FLEET_HOME=C:\data `
    FLEET_SECRETS_FILE=C:\data\secrets\passwords.cfg `
    FLEET_PORT=8787

WORKDIR C:\src
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install ".[container]"

WORKDIR C:\data
VOLUME C:\data
EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 `
  CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/healthz' % os.environ.get('FLEET_PORT','8787'), timeout=4)"

ENTRYPOINT ["cmd", "/S", "/C", "aredn-fleet serve --host 0.0.0.0 --port %FLEET_PORT%"]
