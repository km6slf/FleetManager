# Copy to ".env" next to docker-compose.yml and fill in. Keep this file private.

# Unlocks the encrypted file with saved node and Wi-Fi passwords. Pick a long one and keep it:
# changing it later makes the saved passwords unreadable.
FLEET_SECRETS_PASSWORD=

# LAN address of the mesh node this machine is cabled to, e.g. 10.99.154.177
# (Linux: `ip route` -> "default via ..." on that interface; Windows: `ipconfig` -> Default Gateway)
AREDN_FLEET_DNS=

# Image tag: dev (newest build of main), latest (newest numbered release with a Docker
# image; the first will be the release after 0.1.0-alpha.1), or a version to stay on it.
FLEET_TAG=dev

# Optional: fixed access token (16+ characters); leave empty to have one made and kept.
FLEET_TOKEN=

# Optional: name or address shown in the link in the logs (e.g. this machine's LAN name).
FLEET_PUBLIC_HOST=localhost
