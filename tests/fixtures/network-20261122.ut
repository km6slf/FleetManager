{%
// Excerpt of /app/main/status/e/network.ut from AREDN nightly 20261122-5e4131bf
// (GPL-3.0, (C) Tim Wilkinson and AREDN contributors), trimmed for tests.
if (request.env.REQUEST_METHOD === "PUT") {
    configuration.prepareChanges();
    if ("wan_mtu" in request.args) {
        configuration.setSettingAsString("wan_mtu", request.args.wan_mtu);
    }
    if ("mesh_to_local_wan" in request.args) {
        uciMesh.set("aredn", "@wan[0]", "mesh_to_local_wan", request.args.mesh_to_local_wan === "on" ? 1 : 0);
    }
    if ("lan_to_remote_wan" in request.args) {
        uciMesh.set("aredn", "@wan[0]", "lan_to_remote_wan", request.args.lan_to_remote_wan === "on" ? 1 : 0);
    }
    if ("lan_dhcp_route" in request.args) {
        uciMesh.set("aredn", "@wan[0]", "lan_dhcp_route", request.args.lan_dhcp_route === "on" ? 1 : 0);
    }
    if ("lan_dhcp_defaultroute" in request.args) {
        uciMesh.set("aredn", "@wan[0]", "lan_dhcp_defaultroute", request.args.lan_dhcp_defaultroute === "on" ? 1 : 0);
    }
    if ("mesh_internet" in request.args) {
        uciMesh.set("aredn", "@wan[0]", "mesh_internet", request.args.mesh_internet === "on" ? 1 : 0);
    }
    if ("local_defaultroute" in request.args) {
        uciMesh.set("aredn", "@wan[0]", "local_defaultroute", request.args.local_defaultroute === "on" ? 1 : 0);
    }
    if ("firewall" in request.args) {
        if (request.args.firewall === "on") {
            uciMesh.set("aredn", "@wan[0]", "passthrough", 0);
        }
        else {
            uciMesh.set("aredn", "@wan[0]", "passthrough", 1);
            uciMesh.set("aredn", "@wan[0]", "lan_dhcp_route", 1);
            uciMesh.set("aredn", "@wan[0]", "mesh_to_local_wan", 0);
            uciMesh.set("aredn", "@wan[0]", "local_defaultroute", 0);
        }
    }
    if ("lan_radio" in request.args) {
        uciMesh.set("aredn", "@babel[0]", "lan_radio", request.args.lan_radio === "on" ? "1" : "0");
    }
    uciMesh.commit("aredn");
    configuration.saveSettings();
    print(_R("changes"));
    return;
}
%}
{%
const wan_passthrough = uciMesh.get("aredn", "@wan[0]", "passthrough") == "1";
%}
            </div>
            {{_H("By default, the WAN has an MTU of 1500. On some networks it might be necessary to reduce this value.")}}
            <div class="cols">
                <div>
                    <div class="o">Mesh to WAN</div>
                    <div class="m">Allow any mesh device to use local WAN.</div>
                </div>
                <div style="flex:0">
                    {{_R("switch", { name: "mesh_to_local_wan", value: uciMesh.get("aredn", "@wan[0]", "mesh_to_local_wan") !== "0", disabled: wan_passthrough })}}
                </div>
            </div>
            {{_H("Allow any node or device on the mesh to use our local Internet connection. This is disabled by default.")}}
            <div class="cols">
                <div>
                    <div class="o">DtD to WAN</div>
                    <div class="m">Allow any DtD connected node to use local WAN.</div>
                </div>
                <div style="flex:0">
                    {{_R("switch", { name: "local_defaultroute", value: uciMesh.get("aredn", "@wan[0]", "local_defaultroute") !== "0", disabled: wan_passthrough })}}
                </div>
            </div>
            {{_H("If we have a WAN connection, allow locally connected (via DtD) nodes to also use it.")}}
            <div class="cols">
                <div>
                    <div class="o">LAN to WAN</div>
                    <div class="m">Allow any LAN device to use local WAN.</div>
                </div>
                <div style="flex:0">
                    {{_R("switch", { name: "lan_dhcp_route", value: uciMesh.get("aredn", "@wan[0]", "lan_dhcp_route") !== "0", disabled: wan_passthrough })}}
                </div>
            </div>
            {{_H("Allow LAN devices connected to this node to use our Internet connection. This is enabled by default.")}}
            <div class="cols">
                <div>
                    <div class="o">LAN to Mesh WAN</div>
                    <div class="m">Allow any LAN device to use remote WAN.</div>
                </div>
                <div style="flex:0">
                    {{_R("switch", { name: "lan_to_remote_wan", value: uciMesh.get("aredn", "@wan[0]", "lan_to_remote_wan") !== "0" })}}
                </div>
            </div>
            {{_H("Allow LAN devices connected to this node to use an Internet connection made available somewhere on the Mesh.")}}
            <div class="cols">
                <div>
                    <div class="o">LAN default route</div>
                    <div class="m">Provide LAN devices with a default route.</div>
                </div>
                <div style="flex:0">
                    {{_R("switch", { name: "lan_dhcp_defaultroute", value: uciMesh.get("aredn", "@wan[0]", "lan_dhcp_defaultroute") !== "0" })}}
                </div>
            </div>
            {{_H("Provide a default route to a LAN connected device, even if our local WAN is disabled. By default this is only provided to
            devices if our local WAN is available.")}}
            <div class="cols">
                <div>
                    <div class="o">WAN firewall</div>
                    <div class="m">Enable the WAN firewall and NAT.</div>
                </div>
                <div style="flex:0">
                    {{_R("switch", { name: "firewall", value: uciMesh.get("aredn", "@wan[0]", "passthrough") === "0" })}}
                </div>
            </div>
            {{_H("Disabling the WAN firewall and NAT allows traffic from the WAN to be routed directly to LAN devices.
                  Disabling the firewall automatically disables other WAN features.")}}
            <div class="cols">
                <div>
                    <div class="o">LAN radio</div>
                    <div class="m">Allow babel connections via a non-AREDN LAN radio</div>
                </div>
                <div style="flex:0">
                    {{_R("switch", { name: "lan_radio", value: uciMesh.get("aredn", "@babel[0]", "lan_radio") === "1" })}}
                </div>
            </div>
            {{_H("Allows AREDN to connect to other AREDN nodes over the LAN network. This simplifies adding non-AREDN radios to extend the network.
                Each LAN port must only be connected to a single non-AREDN radio.")}}
            <div class="cols">
                <div>
                    <div class="o">Mesh Internet Router</div>
                    <div class="m">Allow other nodes to route Internet bound traffic via this node.</div>
                </div>
                <div style="flex:0">
                    {{_R("switch", { name: "mesh_internet", value: uciMesh.get("aredn", "@wan[0]", "mesh_internet") !== "0" })}}
                </div>
            </div>
            {{_H("By default a node will route any kind of traffic to any destination. In some circumstances you may wish to restrict
            traffic which is bound for the Internet. Disabling this option stops Internet traffic from traversing this node.
            It also prevents this node from accessing the Internet unless it is provided locally.")}}
